# Mock 模式：无需任何 Key，全流程离线可演示
MOCK_LLM=true

# 真实模式：把 MOCK_LLM 改为 false 并填入百炼 Key
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_EXTRACT=qwen3.7-plus
LLM_MODEL_CHAT=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
# 会议室实时转写（百炼 Qwen-ASR，OpenAI 兼容接口；Mock 模式用演示录音，不调用）
ASR_MODEL=qwen3-asr-flash

# 钉钉视频会议云录制（闪记）转写导入：钉钉开发者后台建「企业内部应用」，开通「视频会议信息读权限」
# 不填就用演示数据（按官方响应格式构造）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 可选：默认用哪个人的 unionId 查询（一般是开会的组长）
DINGTALK_UNION_ID=
